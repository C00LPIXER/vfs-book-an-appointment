# ---- VFS account (optional: bot pre-fills the login form; you still solve the Cloudflare check) ----
VFS_EMAIL=you@example.com
VFS_PASSWORD=your-password

# ---- Telegram (create bot via @BotFather, get chat id via @userinfobot) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email (Gmail: use an App Password, not your normal one) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# ---- Phone call via Twilio (https://console.twilio.com) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
CALL_TO=+91XXXXXXXXXX
